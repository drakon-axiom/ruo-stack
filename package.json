{
  "name": "ruostack",
  "version": "0.0.0",
  "private": true,
  "description": "RUOStack — two-sided white-label fulfillment platform (Phase 0 foundations)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @ruostack/api dev",
    "dev:admin": "pnpm --filter @ruostack/admin-web dev",
    "dev:brand": "pnpm --filter @ruostack/brand-web dev",
    "db:generate": "pnpm --filter @ruostack/db run generate",
    "db:migrate": "pnpm --filter @ruostack/db run migrate",
    "db:deploy": "pnpm --filter @ruostack/db run deploy",
    "seed:superadmin": "pnpm --filter @ruostack/api seed:superadmin",
    "test": "pnpm -r test",
    "lint:stripe-guard": "node scripts/check-stripe-imports.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:legacy-classes": "node scripts/check-legacy-classes.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
