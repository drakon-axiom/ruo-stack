# Substitution values for the dev environment. Data only -- sourced by render.sh.
BRAND_HOST=app.dev.ruostack.io
ADMIN_HOST=backend.dev.ruostack.io

# Supabase project this environment is pinned to. deploy.sh refuses to run if
# the repo-root .env points anywhere else -- see deploy/check-env-ref.sh.
SUPABASE_REF=kcgqabbiihtfxczhpyfs

# ORIGIN_IP: acgserver02, this box. EDGE_IP: srv1153350, the reverse-proxy VPS.
ORIGIN_IP=100.99.76.119
EDGE_IP=100.99.76.10

# Origin listens on these; the edge maps hostname -> port.
BRAND_ORIGIN_PORT=8901
ADMIN_ORIGIN_PORT=8902

# Loopback only -- reachable solely by origin nginx.
API_PORT=3901
API_UPSTREAM=ruostack_api_dev

# Edge upstream names. The edge VPS serves the dev AND prod hostnames from one
# nginx, so every name here must be env-unique or the two configs collide.
EDGE_BRAND_UPSTREAM=ruostack_edge_brand_dev
EDGE_ADMIN_UPSTREAM=ruostack_edge_admin_dev

# Edge asset cache. Hashed filenames are immutable, so the edge can answer
# /assets/ without crossing the ~53ms Tailscale hop to the origin. Transient by
# design: nothing deploys here, and a new build emits new names.
EDGE_CACHE_ZONE=ruostack_edge_dev
EDGE_CACHE_PATH=/var/cache/nginx/ruostack-dev

BRAND_ROOT=/var/www/app.dev.ruostack.io/html
ADMIN_ROOT=/var/www/backend.dev.ruostack.io/html
LOG_PREFIX=ruostack-dev

# The marketing site is production-only.
LANDING=0
