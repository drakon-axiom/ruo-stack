# Substitution values for the production environment.
BRAND_HOST=app.ruostack.io
ADMIN_HOST=backend.ruostack.io

# Supabase project this environment is pinned to. deploy.sh refuses to run if
# the repo-root .env points anywhere else -- see deploy/check-env-ref.sh.
SUPABASE_REF=nanixtzbmorpojnyverq

ORIGIN_IP=100.99.76.119
EDGE_IP=100.99.76.10

BRAND_ORIGIN_PORT=8911
ADMIN_ORIGIN_PORT=8912

API_PORT=3911
API_UPSTREAM=ruostack_api_prod

# Edge upstream names. The edge VPS serves the dev AND prod hostnames from one
# nginx, so every name here must be env-unique or the two configs collide.
EDGE_BRAND_UPSTREAM=ruostack_edge_brand_prod
EDGE_ADMIN_UPSTREAM=ruostack_edge_admin_prod
EDGE_LANDING_UPSTREAM=ruostack_edge_landing_prod

# Edge asset cache. Hashed filenames are immutable, so the edge can answer
# /assets/ without crossing the ~53ms Tailscale hop to the origin. Transient by
# design: nothing deploys here, and a new build emits new names.
EDGE_CACHE_ZONE=ruostack_edge_prod
EDGE_CACHE_PATH=/var/cache/nginx/ruostack-prod

BRAND_ROOT=/var/www/app.ruostack.io/html
ADMIN_ROOT=/var/www/backend.ruostack.io/html
LOG_PREFIX=ruostack-prod

LANDING=1
LANDING_HOST=ruostack.com
LANDING_ROOT=/var/www/ruostack.com/html
LANDING_ORIGIN_PORT=8913
