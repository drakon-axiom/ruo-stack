# dependencies
node_modules/
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env
.env
.env*.local
.env.local
# Any .env sidecar -- backups (.env.p, .env.bak), per-env copies, scratch edits.
# These carry the same secrets as .env but were not covered by the rules above,
# so `git add -A` would stage them; a Stripe key reached a local commit that way
# on 2026-08-10 and was caught only by GitHub push protection.
**/.env.*
# ...except the committed template, which holds placeholders only.
!**/.env.example

# supabase
/supabase/.branches
/supabase/.temp
**/.env

# editor swap/backup files. These carry the contents of whatever is being
# edited, so a swap file for .env holds .env's secrets. nano names its swap
# `..env.swp` for `.env`, which the `**/.env.*` rule above does NOT match --
# the name starts with two dots. `git add -A` staged one on 2026-08-11.
*.swp
*.swo
*.swn
*~
.*.sw?
..*.sw?

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo

# monorepo build artifacts
dist/
**/dist/
.turbo/
coverage/

# prisma generated client
packages/db/generated/
**/.prisma/

# vite
**/.vite/
.superpowers/

# rendered nginx configs (derived; certbot edits the deployed edge copy)
deploy/nginx/out/

# Playwright
test-results/
playwright-report/
packages/ui/gallery/dist/
