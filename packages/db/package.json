{
  "name": "@ruostack/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "pnpm run --silent with-env prisma migrate dev",
    "deploy": "pnpm run --silent with-env prisma migrate deploy",
    "status": "pnpm run --silent with-env prisma migrate status",
    "studio": "pnpm run --silent with-env prisma studio",
    "with-env": "set -a && . ../../.env && set +a && exec",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.1.0",
    "typescript": "^5.6.3"
  }
}
