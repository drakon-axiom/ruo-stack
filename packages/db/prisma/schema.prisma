// RUOStack — Phase 0 Prisma schema.
// Prisma manages the `public` schema ONLY — never auth/storage/realtime.
// All money is integer cents. All tables get created_at; mutable ones updated_at.
// The brand "person" is a Supabase `auth.users` row (Supabase owns credentials,
// password hashes, sessions, MFA factors) — never duplicated here.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // tx pooler 6543 + ?pgbouncer=true (runtime)
  directUrl = env("DIRECT_URL") // session/direct 5432 (migrations)
}

generator client {
  provider = "prisma-client-js"
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum SubscriptionStatus {
  none
  pro

  @@map("subscription_status")
}

enum BrandStatus {
  active
  suspended

  @@map("brand_status")
}

enum BrandMemberRole {
  owner
  staff

  @@map("brand_member_role")
}

enum BrandMemberStatus {
  active
  invited
  suspended

  @@map("brand_member_status")
}

enum BrandRealm {
  brand

  @@map("brand_realm")
}

enum AdminRole {
  super_admin
  operations
  support
  finance

  @@map("admin_role")
}

enum AdminStatus {
  active
  suspended

  @@map("admin_status")
}

enum ActorType {
  admin
  brand
  system

  @@map("actor_type")
}

enum CatalogStatus {
  in_stock
  soon
  out_of_stock

  @@map("catalog_status")
}

enum WebhookSource {
  stripe
  woocommerce

  @@map("webhook_source")
}

enum StorePlatform {
  woocommerce
  wix

  @@map("store_platform")
}

enum StoreConnectionStatus {
  active
  error
  disabled

  @@map("store_connection_status")
}

enum WebhookStatus {
  received
  processed
  failed

  @@map("webhook_status")
}

enum TaxExemptionStatus {
  none
  on_file
  expired

  @@map("tax_exemption_status")
}

// ── Brand realm (app data keyed to Supabase auth.users) ──────────────────────

/// realm: brand. id == auth.users.id (FK by convention; auth schema is Supabase-owned).
/// Does NOT recreate password_hash/MFA — Supabase Auth owns those.
model UserProfile {
  id                  String   @id @db.Uuid // == auth.users.id
  fullName            String   @map("full_name")
  nameLastChangedAt   DateTime? @map("name_last_changed_at") // enforces "name editable once / 7 days"
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

/// The tenant.
model Brand {
  id                 String             @id @default(uuid()) @db.Uuid
  brandName          String             @map("brand_name")
  status             BrandStatus        @default(active)
  logoUrl            String?            @map("logo_url")
  primaryColor       String?            @map("primary_color") // brand theme, hex (#RRGGBB)
  accentColor        String?            @map("accent_color") // brand accent, hex (#RRGGBB)
  website            String?
  salesChannel       String?            @map("sales_channel")
  subscriptionStatus SubscriptionStatus @default(none) @map("subscription_status") // convenience flag; SubscriptionState is SoT in Phase 1
  stripeCustomerId   String?            @unique @map("stripe_customer_id") // webhook tenant-lookup key — unique + indexed
  memberSince        DateTime           @default(now()) @map("member_since")
  referralCode       String             @unique @map("referral_code")
  referredBy         String?            @map("referred_by") // store only; reward logic is later
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  members           BrandMember[]
  userRoles         BrandUserRole[]
  taxExemptions     BrandTaxExemption[]
  subscriptionState  SubscriptionState?
  walletLedger       WalletLedger[]
  brandProductPrices BrandProductPrice[]
  orders             Order[]
  storeConnections   BrandStoreConnection[]
  shippingConfig     BrandShippingConfig?
  productAliases     ProductAlias[]
  claims             Claim[]
  addresses          Address[]
  announcements      Announcement[]
  provisionings      ProductProvisioning[]

  @@map("brand")
}

/// Saved ship-to (recipient) addresses for a brand's Address Book. Manually
/// curated; auto-fills the manual order form. Distinct from the brand's own
/// return address (a separate, later slice). No link to Order — a saved address
/// is a template, snapshotted onto the order at placement time.
model Address {
  id             String   @id @default(uuid()) @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  label          String? // optional nickname, e.g. "John — home"
  recipientName  String   @map("recipient_name")
  recipientEmail String?  @map("recipient_email")
  recipientPhone String?  @map("recipient_phone")
  address1       String   @map("address1")
  address2       String?  @map("address2")
  city           String
  state          String
  zip            String
  country        String   @default("US")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_address")
}

/// Per-brand shipping pricing (rate proxy §12). The pick-&-pack fee is RUOStack's
/// margin (global default + optional per-brand override); the markup is the
/// brand's shipping profit (default $0). `enabledServices` scopes which carrier
/// services are offered at checkout (empty = all configured).
model BrandShippingConfig {
  id                     String   @id @default(uuid()) @db.Uuid
  brandId                String   @unique @map("brand_id") @db.Uuid
  pickpackFeeOverrideCents Int?   @map("pickpack_fee_override_cents") // null → use global default
  markupCents            Int      @default(0) @map("markup_cents")
  enabledServices        String[] @default([]) @map("enabled_services")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_shipping_config")
}

/// Join: which users belong to which brand. MVP creates exactly one `owner`.
model BrandMember {
  id        String            @id @default(uuid()) @db.Uuid
  brandId   String            @map("brand_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid // -> auth.users.id
  role      BrandMemberRole
  status    BrandMemberStatus @default(active)
  invitedAt DateTime?         @map("invited_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId])
  @@map("brand_member")
}

/// Server-owned source for the custom access token hook (NOT user_metadata).
/// The hook reads this to inject realm + brand_id claims; written only by the API.
model BrandUserRole {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  realm     BrandRealm @default(brand)
  brandId   String     @map("brand_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([userId])
  @@map("brand_user_role")
}

// ── Admin realm (option a: separate from the customer pool) ───────────────────

model AdminUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  role         AdminRole
  status       AdminStatus @default(active)
  mfaEnabled   Boolean     @default(false) @map("mfa_enabled")
  mfaSecret    String?     @map("mfa_secret") // encrypted at rest (AES-256-GCM)
  lastLoginAt  DateTime?   @map("last_login_at")
  createdBy    String?     @map("created_by") @db.Uuid // AdminUser.id
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  sessions     AdminSession[]
  resetTokens  AdminPasswordResetToken[]

  @@map("admin_user")
}

/// Revocable admin refresh tokens (option a only; Supabase Auth manages brand sessions).
model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_session")
}

/// Option a only; brand resets are handled by Supabase Auth.
model AdminPasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_password_reset_token")
}

// ── Audit spine ───────────────────────────────────────────────────────────────

/// APPEND-ONLY. A BEFORE UPDATE OR DELETE trigger raises (robust vs the service
/// role); an RLS insert/select-only policy is a second layer. No updated_at, no
/// soft-delete. One row per mutating admin action / sensitive brand action.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ── Catalog master (operator-owned) ───────────────────────────────────────────

/// Operator-owned master; the brand-facing Product is a READ PROJECTION of this.
/// `is_published`: while false, canonical_sku is editable and the product does
/// NOT project to brands; on publish, the SKU LOCKS and it becomes brand-visible.
model CatalogProduct {
  id                  String        @id @default(uuid()) @db.Uuid
  canonicalSku        String        @unique @map("canonical_sku")
  compound            String
  dose                String?
  unit                String?
  name                String
  descriptionTemplate String?       @map("description_template")
  wholesaleStarter    Int           @map("wholesale_starter") // cents — Starter tier rate
  wholesalePro        Int           @map("wholesale_pro") // cents — Pro tier rate
  wholesaleVolume     Int           @map("wholesale_volume") // cents — Volume tier rate
  suggestedRetail     Int           @map("suggested_retail") // cents (operator suggestion; brand can override)
  status              CatalogStatus @default(soon) // stock state
  isPublished         Boolean       @default(false) @map("is_published")
  /// Retired. A published product can never be hard-deleted (orders, aliases and
  /// provisioning records reference it), so retiring one archives it instead.
  /// Gated on status = out_of_stock, so a product is pulled from brand stores
  /// before it disappears from the catalog. Archived products are excluded from
  /// every brand-facing query and are never sellable.
  archived            Boolean       @default(false)
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  packagingRule       String?       @map("packaging_rule")
  coaId               String?       @map("coa_id")
  images              String[]      @default([])
  updatedBy           String?       @map("updated_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  brandPrices   BrandProductPrice[]
  orderItems    OrderItem[]
  aliases       ProductAlias[]
  provisionings ProductProvisioning[]

  @@index([status])
  @@index([isPublished])
  @@index([archived])
  @@map("catalog_product")
}

/// Maps a brand's store SKU → our canonical product, for store items that don't
/// match by exact SKU (renamed/own/pre-existing products). Resolves order-time
/// matching to canonical; set in the admin Store-Match screen (§3 aliases).
model ProductAlias {
  id           String   @id @default(uuid()) @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  wooSku       String   @map("woo_sku") // the brand's store SKU (the join key)
  wooProductId String?  @map("woo_product_id") // informational
  productId    String   @map("product_id") @db.Uuid // resolves to our canonical product
  createdBy    String?  @map("created_by") @db.Uuid // AdminUser.id
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([brandId, wooSku])
  @@index([brandId])
  @@map("product_alias")
}

// ── Store connections (Phase 2: WooCommerce hub-and-spoke) ────────────────────

/// A brand's connected storefront (WooCommerce first). RUOStack is the hub: it
/// pulls orders in via webhook and writes tracking back via the store's REST API.
/// REST credentials are AES-256-GCM encrypted at rest; `webhook_secret` is the
/// per-connection HMAC key we generate and configure on the store's webhook.
model BrandStoreConnection {
  id                String                @id @default(uuid()) @db.Uuid
  brandId           String                @map("brand_id") @db.Uuid
  platform          StorePlatform         @default(woocommerce)
  storeUrl          String                @map("store_url")
  consumerKeyEnc    String                @map("consumer_key_enc") // encrypted ck_…
  consumerSecretEnc String                @map("consumer_secret_enc") // encrypted cs_…
  webhookSecret     String                @map("webhook_secret") // HMAC key for inbound webhooks
  webhookIds        Int[]                 @default([]) @map("webhook_ids") // registered Woo webhook ids (for cleanup)
  status            StoreConnectionStatus @default(active)
  lastError         String?               @map("last_error")
  lastOrderAt       DateTime?             @map("last_order_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  brand         Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  provisionings ProductProvisioning[]

  @@unique([brandId, platform]) // one store per platform per brand (for now)
  @@index([brandId])
  @@map("brand_store_connection")
}

// ── Fulfillment rules engine (Phase 2 §6) ─────────────────────────────────────
// Admin-configurable so ops never hand-picks boxes/services and a threshold
// change needs no code deploy. Weights in ounces, dims in inches.

enum ServiceTier {
  economy
  standard
  expedited

  @@map("service_tier")
}

enum ServiceSelectionPolicy {
  cheapest // least-cost-select within the tier
  fixed // always offer this exact service

  @@map("service_selection_policy")
}

/// Box catalog: the engine picks the smallest box that fits by volume + weight,
/// then derives billable weight = max(actual + tare, dimensional).
model Box {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  innerLengthIn Float    @map("inner_length_in")
  innerWidthIn  Float    @map("inner_width_in")
  innerHeightIn Float    @map("inner_height_in")
  maxWeightOz   Int      @map("max_weight_oz")
  tareOz        Int      @default(0) @map("tare_oz")
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([enabled])
  @@map("box")
}

/// Enabled carrier services per tier, with eligibility + selection policy. Drives
/// which named services are offered at checkout and how raw rates are relabeled.
model ServiceMapping {
  id                String                @id @default(uuid()) @db.Uuid
  tier              ServiceTier
  carrierServiceCode String               @unique @map("carrier_service_code") // matches the rater's serviceCode
  displayLabel      String                @map("display_label")
  transitEstimate   String                @map("transit_estimate")
  maxWeightOz       Int                   @map("max_weight_oz") // eligibility ceiling
  enabled           Boolean               @default(true)
  selectionPolicy   ServiceSelectionPolicy @default(cheapest) @map("selection_policy")
  sortOrder         Int                   @default(0) @map("sort_order")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([tier])
  @@map("service_mapping")
}

/// A persisted checkout rate quote (§9 quote-driven reserve). When the order
/// imports, we reserve the EXACT quoted shipping (brand cost = carrier_cost +
/// pickpack) and lock the box/weight from here, rather than re-rating. Keyed by a
/// stable cart_hash (sorted SKU:qty + destination) + service. Short-lived.
model RateQuote {
  id                 String   @id @default(uuid()) @db.Uuid
  brandId            String   @map("brand_id") @db.Uuid
  cartHash           String   @map("cart_hash")
  destZip            String   @map("dest_zip")
  destState          String   @map("dest_state")
  serviceCode        String   @map("service_code")
  carrierCostCents   Int      @map("carrier_cost_cents") // pass-through carrier cost
  pickpackCents      Int      @map("pickpack_cents") // RUOStack margin
  brandMarkupCents   Int      @map("brand_markup_cents")
  customerPriceCents Int      @map("customer_price_cents")
  boxId              String?  @map("box_id") @db.Uuid
  billableWeightOz   Int      @map("billable_weight_oz")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([brandId, cartHash, serviceCode])
  @@index([expiresAt])
  @@map("rate_quote")
}

// ── Processor seam ────────────────────────────────────────────────────────────

/// Idempotency for the Phase 0 webhook receiver (Phase 1 builds ledger on this).
model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  source      WebhookSource
  externalId  String        @map("external_id")
  type        String
  payload     Json
  status      WebhookStatus @default(received)
  attempts    Int           @default(0)
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([source, externalId])
  @@map("webhook_event")
}

// ── SALT footprint (schema only in Phase 0 — no endpoints/UI) ─────────────────
// Orphaned by design: tracked in POLISH_TODO.md ("Tax exemptions UI/endpoints").
// The upload endpoint + admin review land in a later phase behind the SALT pass.

/// Gives the SALT determination somewhere to land later (architecture §5.3).
model BrandTaxExemption {
  id             String             @id @default(uuid()) @db.Uuid
  brandId        String             @map("brand_id") @db.Uuid
  state          String
  certificateRef String?            @map("certificate_ref")
  expiresAt      DateTime?          @map("expires_at")
  status         TaxExemptionStatus @default(none)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_tax_exemption")
}

// ── Money layer (Phase 1) ─────────────────────────────────────────────────────
// Membership and wallet are DIFFERENT money concerns and never commingle
// (architecture §4.1): a membership charge never touches WalletLedger; a wallet
// deposit never touches SubscriptionState.

/// How a membership stands. `suspended` is RETAINED for historical rows only —
/// it is no longer written (migration 025/026). A membership that lapsed for
/// non-payment is `expired`; account-level suspension for cause lives on
/// `Brand.status` and is the only one of the two that denies requests.
enum SubscriptionStateStatus {
  none
  active
  past_due
  expired
  cancelled
  suspended

  @@map("subscription_state_status")
}

enum PlanTier {
  starter
  pro
  volume

  @@map("plan_tier")
}

/// Wallet ledger transaction types. NOTE: `hold` / `hold_release` are RESERVED
/// but currently UNUSED — the wallet reserve is IMPLICIT (getHeld() derives held
/// funds by summing open orders; see apps/api/src/services/wallet.ts), so no hold
/// rows are written. They are kept for a future explicit-hold model; removing an
/// enum value in Postgres requires a type rebuild, so leave them until then.
enum WalletTxnType {
  deposit
  hold // reserved — implicit holds today (see note above)
  hold_release // reserved — see note above
  capture
  refund_credit
  referral_credit
  manual_adjustment

  @@map("wallet_txn_type")
}

enum OrderSource {
  manual
  woocommerce
  wix

  @@map("order_source")
}

enum OrderStatus {
  ready_for_fulfillment
  processing
  shipped
  delivered
  cancelled

  @@map("order_status")
}

enum OrderBlocker {
  none
  needs_address
  needs_customer_info
  needs_mapping // a store order line had a SKU we couldn't match to the catalog
  awaiting_funds

  @@map("order_blocker")
}

/// One per brand. Driven ONLY by billing webhooks (invoice.paid / payment_failed
/// / subscription.*). Source of truth for membership; Brand.subscription_status
/// is a convenience mirror.
model SubscriptionState {
  id                   String                  @id @default(uuid()) @db.Uuid
  brandId              String                  @unique @map("brand_id") @db.Uuid
  stripeSubscriptionId String?                 @map("stripe_subscription_id")
  plan                 PlanTier                @default(starter)
  price                Int                     @default(0) // cents
  status               SubscriptionStateStatus @default(none)
  currentPeriodEnd     DateTime?               @map("current_period_end")
  cancelAtPeriodEnd    Boolean                 @default(false) @map("cancel_at_period_end")
  pastDueSince         DateTime?               @map("past_due_since") // dunning: when payment first failed
  dunningNotifiedAt    DateTime?               @map("dunning_notified_at") // when we sent the payment-failed notice
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("subscription_state")
}

/// Append-only prepaid wallet ledger. `balance_after` is the running available
/// balance after this entry; current balance = the row with the greatest `seq`.
/// Non-refundable / non-withdrawable by design (closed-loop; payments §2) — there
/// is deliberately no withdrawal entry type. Idempotent on external_id (the
/// processor event id) so a replayed webhook can't double-credit.
model WalletLedger {
  id           String        @id @default(uuid()) @db.Uuid
  seq          BigInt        @default(autoincrement()) @unique
  brandId      String        @map("brand_id") @db.Uuid
  type         WalletTxnType
  amount       Int // signed delta, cents
  balanceAfter Int           @map("balance_after") // cents
  externalId   String?       @unique @map("external_id") // processor event id (idempotency)
  reason       String?
  createdBy    String?       @map("created_by") @db.Uuid // AdminUser.id for manual_adjustment
  createdAt    DateTime      @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, seq])
  @@map("wallet_ledger")
}

/// A brand's own retail price for a product — overrides CatalogProduct.suggested_retail.
/// The brand sets this in their portal; defaults to the operator suggestion if absent.
model BrandProductPrice {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  retailCents Int      @map("retail_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([brandId, productId])
  @@index([brandId])
  @@map("brand_product_price")
}

// ── Orders (Phase 1: manual-first) ────────────────────────────────────────────
// Funds model: placing an order reserves funds implicitly (held = sum of open
// orders); shipping CAPTURES the wallet (a capture ledger entry). Insufficient
// available funds → blocker awaiting_funds.

/// A brand's order. Line items snapshot the brand's tier wholesale at order time.
model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  brandId            String       @map("brand_id") @db.Uuid
  source             OrderSource  @default(manual)
  status             OrderStatus  @default(ready_for_fulfillment)
  blocker            OrderBlocker @default(none)
  externalOrderId    String?      @map("external_order_id") // store order id (Woo/Wix; Phase 1.5)
  sourceItems        Json?        @map("source_items") // raw store line items [{sku,qty}] for re-mapping
  unmatchedSkus      String[]     @default([]) @map("unmatched_skus") // No-Match SKUs awaiting an alias

  // Shipping recipient (manual entry; Customer/Address Book is a later slice).
  recipientName  String  @map("recipient_name")
  recipientEmail String? @map("recipient_email")
  recipientPhone String? @map("recipient_phone")
  address1       String  @map("address1")
  address2       String? @map("address2")
  city           String
  state          String
  zip            String
  country        String  @default("US")

  wholesaleTotalCents Int       @map("wholesale_total_cents")
  shippingTotalCents  Int       @map("shipping_total_cents")
  walletChargeCents   Int       @map("wallet_charge_cents")
  shippingServiceCode String?   @map("shipping_service_code") // rated service to buy at ship
  shippingCarrier     String?   @map("shipping_carrier") // rated carrier label
  rateSource          String?   @map("rate_source") // how shipping was priced: flat|fallback|shipstation|computed|quote
  // Locked package (rules engine §6): the box + billable weight chosen at rate-time.
  boxId               String?   @map("box_id") @db.Uuid
  boxName             String?   @map("box_name")
  boxLengthIn         Float?    @map("box_length_in")
  boxWidthIn          Float?    @map("box_width_in")
  boxHeightIn         Float?    @map("box_height_in")
  billableWeightOz    Int?      @map("billable_weight_oz")
  trackingNumber      String?   @map("tracking_number")
  carrier             String?
  labelUrl            String?   @map("label_url")
  labelCostCents      Int?      @map("label_cost_cents") // actual carrier cost (RUOStack's)
  exportedAt          DateTime? @map("exported_at") // first time ShipStation pulled it via the custom-store export
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  brand Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  box   Box?        @relation(fields: [boxId], references: [id], onDelete: SetNull)
  items OrderItem[]
  claims Claim[]

  // Store-order idempotency: at most one order per (brand, source, external id).
  // externalOrderId is NULL for manual orders — Postgres treats NULLs as distinct,
  // so manual orders never collide; store orders (Woo/Wix) dedupe on their id.
  @@unique([brandId, source, externalOrderId])
  @@index([brandId, status])
  @@index([status])
  @@map("order")
}

// ── Claims (Phase 3 §11: no refunds once shipped — post-ship remedy path) ──────

enum ClaimType {
  lost
  damaged
  missing_item
  item_not_received
  wrong_item

  @@map("claim_type")
}

enum ClaimStatus {
  open
  investigating
  carrier_filed
  resolved

  @@map("claim_status")
}

enum ClaimResolution {
  reshipped
  credited
  denied

  @@map("claim_resolution")
}

/// A post-ship problem (lost/damaged/...) against a shipped order. Resolved by an
/// operator as reship / wallet credit / deny; carrier claim id recorded when filed.
model Claim {
  id             String           @id @default(uuid()) @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  brandId        String           @map("brand_id") @db.Uuid
  type           ClaimType
  status         ClaimStatus      @default(open)
  resolution     ClaimResolution?
  description    String?
  photos         String[]         @default([])
  carrierClaimId String?          @map("carrier_claim_id")
  amountCents    Int?             @map("amount_cents") // credited amount / claim value
  reshipOrderId  String?          @map("reship_order_id") @db.Uuid
  openedByType   ActorType        @map("opened_by_type")
  openedById     String?          @map("opened_by_id")
  reason         String? // resolution reason
  slaDueAt       DateTime         @map("sla_due_at")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([status])
  @@map("claim")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  qty               Int
  unitWholesaleCents Int     @map("unit_wholesale_cents") // snapshot at the brand's tier
  createdAt         DateTime @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_item")
}

// ─────────────────────────── Announcements (architecture §1.1 / §1.3) ────────
// Operator-authored broadcasts that surface in the brand Notifications inbox.

enum AnnouncementAudience {
  all_brands
  /// Reserved: targeting by plan tier / status / store-connection state is a
  /// later slice. Declared now so adding it never migrates existing rows.
  segment
  single_brand

  @@map("announcement_audience")
}

enum AnnouncementType {
  announcement
  restock
  maintenance

  @@map("announcement_type")
}

/// NOTE — the architecture doc lists `status = draft | scheduled | published`.
/// "Scheduled" is fully determined by `publishAt > now`, so storing it as well
/// would be two sources of truth needing a worker to reconcile them. Status is
/// the author's INTENT (draft / published / archived); scheduling lives in
/// `publishAt`, and the admin UI renders a derived "Scheduled" chip. Visibility
/// is computed at read time — see `isAnnouncementVisible` in @ruostack/shared.
enum AnnouncementStatus {
  draft
  published
  archived

  @@map("announcement_status")
}

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  audience  AnnouncementAudience @default(all_brands)
  /// Required when audience = single_brand; null otherwise.
  brandId   String?              @map("brand_id") @db.Uuid
  type      AnnouncementType     @default(announcement)
  title     String
  body      String
  /// null = visible as soon as published; future = scheduled.
  publishAt DateTime?            @map("publish_at")
  /// null = never expires.
  expiresAt DateTime?            @map("expires_at")
  status    AnnouncementStatus   @default(draft)
  createdBy String               @map("created_by") @db.Uuid // AdminUser.id
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  brand Brand?             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reads AnnouncementRead[]

  @@index([status])
  @@index([brandId])
  @@map("announcement")
}

/// Per-USER read receipt (not per-brand): brand staff each track their own
/// inbox, which is already correct for when the invite-staff UI lands. Absence
/// of a row means unread — nothing is written until a user actually reads.
model AnnouncementRead {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid // auth.users.id (brand realm)
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_read")
}

/// Provisioning identity (fulfillment plan §3): the record of what RUOStack
/// actually created in a brand's store. Stable identity is the Woo
/// `product_id` recorded at creation — NOT the SKU — so re-pushes are idempotent
/// and survive a brand renaming a SKU.
///
/// Without this row the pre-flight cannot tell **Managed** (ours, safe to touch)
/// from **Conflict** (the brand's own product that happens to carry our SKU), and
/// cannot detect **Drift** at all. It is the difference between "update" and
/// "overwrite someone else's work".
model ProductProvisioning {
  id               String   @id @default(uuid()) @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  connectionId     String   @map("connection_id") @db.Uuid
  catalogProductId String   @map("catalog_product_id") @db.Uuid
  /// The store's product id — the stable join.
  wooProductId     Int      @map("woo_product_id")
  /// The SKU as it stands in the store for this product. Normally the canonical
  /// SKU; after a re-alias it is the brand's own SKU, and the ProductAlias row
  /// carries the mapping back to canonical.
  provisionedSku   String   @map("provisioned_sku")
  /// True when the brand claimed a pre-existing product (Conflict → Adopt)
  /// rather than RUOStack creating it. Kept so "did we make this?" stays
  /// answerable after the fact.
  adopted          Boolean  @default(false)
  lastPushedAt     DateTime @default(now()) @map("last_pushed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  brand      Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connection BrandStoreConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    CatalogProduct       @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@unique([connectionId, catalogProductId])
  @@unique([connectionId, wooProductId])
  @@index([brandId])
  @@map("product_provisioning")
}
