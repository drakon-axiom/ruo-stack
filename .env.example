# ──────────────────────────────────────────────────────────────────────────
# RUOStack — environment (Phase 0)
# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# The SERVICE ROLE key and admin secrets are SERVER-ONLY — never shipped to a
# frontend. Frontend-safe vars are prefixed VITE_ (admin-web / brand-web).
# ──────────────────────────────────────────────────────────────────────────

# --- Prisma ↔ Supabase Postgres (see supabase/README.md for the role split) ---
# RUNTIME: dedicated `prisma` (bypassrls) role, transaction pooler (6543) +
# pgbouncer=true (no prepared stmts). Add &connection_limit=1 if serverless.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PRISMA_ROLE_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# MIGRATIONS: privileged `postgres` role, session pooler (5432). Required because
# the RLS policies reference auth.uid() and only privileged roles have auth-schema
# usage. (Region prefix is aws-1 on newer projects, aws-0 on older ones.)
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase (server) ---
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SERVER_ONLY_service_role_key"
SUPABASE_ANON_KEY="anon_publishable_key"

# --- Admin realm (option a: hand-rolled admin JWT, kept OUT of the customer pool) ---
# openssl rand -base64 48
JWT_ADMIN_SECRET="REPLACE_with_64+_random_bytes_base64"
JWT_ADMIN_ACCESS_TTL="900"          # seconds (15 min)
JWT_ADMIN_REFRESH_TTL="2592000"     # seconds (30 days)
# AES-256-GCM key for encrypting AdminUser.mfa_secret at rest. openssl rand -base64 32
MFA_ENCRYPTION_KEY="REPLACE_with_base64_of_32_random_bytes"

# --- Stripe (behind PaymentsAdapter ONLY) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Statement descriptors must read as software/logistics, never peptides.
STRIPE_MEMBERSHIP_PRICE_ID="price_xxx"   # RUOStack Membership (Phase 1 flows; defined now)

# --- API ---
API_PORT="3901"
API_HOST="0.0.0.0"
# Comma-separated allowed origins for CORS (admin-web, brand-web dev servers).
CORS_ORIGINS="http://localhost:3902,http://localhost:3903"
NODE_ENV="development"

# --- Bootstrap (seed:superadmin) ---
SEED_SUPERADMIN_EMAIL="admin@ruostack.local"
SEED_SUPERADMIN_PASSWORD="change-me-on-first-login"

# ──────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — these ARE shipped to the browser. Only public keys here.
# ──────────────────────────────────────────────────────────────────────────
# brand-web (talks to Supabase Auth directly via supabase-js)
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="anon_publishable_key"
VITE_API_BASE_URL="http://localhost:3901"
