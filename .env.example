# ──────────────────────────────────────────────────────────────
# ruo-stack environment
# Copy to .env.local for Next.js, and set the same secrets in the
# Supabase dashboard (Edge Function secrets) for server functions.
# ──────────────────────────────────────────────────────────────

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY

# --- Supabase (server only — NEVER expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Stripe (B2B: Pro subscription + seller wallet top-ups) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRO_PRICE_ID=price_xxx        # $97/mo (or your price) recurring price id

# --- ShipStation (USPS/UPS/FedEx label purchase + tracking) ---
# Classic API uses HTTP Basic auth (key:secret). Set both.
SHIPSTATION_API_KEY=xxx
SHIPSTATION_API_SECRET=xxx

# --- Store credential encryption (woo-sync etc.) ---
# AES-256 key, base64 of 32 random bytes. Generate: openssl rand -base64 32
# Set as a Supabase Edge Function secret, NOT a NEXT_PUBLIC var.
CREDENTIALS_ENC_KEY=BASE64_32_BYTES

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3900
